# =============================================
# LeadPilot AI — Environment Variables
# =============================================
# Copy this file to .env and fill in your values

# --- MongoDB ---
MONGODB_URI=mongodb://localhost:27017/leadpilot

# --- AI Provider Configuration ---
# Choose ONE provider. Leave all blank to use built-in AI Mock Generators (no key needed).
#
# AI_PROVIDER options: openai | gemini | deepseek | grok | groq | together | ollama
#
# OpenAI:    AI_PROVIDER=openai   AI_API_KEY=sk-proj-...          AI_MODEL=gpt-4o-mini
# Gemini:    AI_PROVIDER=gemini   AI_API_KEY=AIzaSy...            AI_MODEL=gemini-1.5-flash
# DeepSeek:  AI_PROVIDER=deepseek AI_API_KEY=sk-...               AI_MODEL=deepseek-chat
# Grok:      AI_PROVIDER=grok     AI_API_KEY=xai-...              AI_MODEL=grok-beta
# Groq:      AI_PROVIDER=groq     AI_API_KEY=gsk_...              AI_MODEL=llama3-8b-8192
# Ollama:    AI_PROVIDER=ollama   AI_API_KEY=ollama               AI_MODEL=llama3
#
AI_PROVIDER=openai
AI_API_KEY=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
AI_MODEL=gpt-4o-mini
#
# Legacy — still works if AI_API_KEY is not set
# OPENAI_API_KEY=sk-your-openai-key-here

# --- API Server ---
PORT=4000
NODE_ENV=development

# --- CORS (Frontend URL) ---
CORS_ORIGIN=http://localhost:3000

# --- Scheduler ---
# Cron expression for daily lead discovery (default: 6am every day)
DISCOVERY_CRON=0 6 * * *

# --- Scraper Settings ---
# Requests per second (be polite to target sites)
SCRAPER_RPS=1
SCRAPER_TIMEOUT_MS=30000

# --- Logging ---
LOG_LEVEL=info
